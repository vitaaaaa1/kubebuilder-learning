package main

import (
	"context"
	"flag"
	"os"

	corev1 "k8s.io/api/core/v1"
	"k8s.io/apimachinery/pkg/runtime"
	_ "k8s.io/client-go/plugin/pkg/client/auth"
	ctrl "sigs.k8s.io/controller-runtime"
	"sigs.k8s.io/controller-runtime/pkg/client"
	"sigs.k8s.io/controller-runtime/pkg/log"
	"sigs.k8s.io/controller-runtime/pkg/log/zap"
)

// PatchingReconciler 演示不同 Patching 策略的 Reconciler
type PatchingReconciler struct {
	client.Client
	Scheme *runtime.Scheme
}

func (r *PatchingReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
	logger := log.FromContext(ctx)

	var cm corev1.ConfigMap
	if err := r.Get(ctx, req.NamespacedName, &cm); err != nil {
		return ctrl.Result{}, client.IgnoreNotFound(err)
	}

	logger.Info("📦 Reconcile triggered", "name", cm.Name, "ns", cm.Namespace)

	// =============================================
	// 🎯 策略 1: MergeFrom（最常用）
	// =============================================
	// 适用场景：修改少量字段，希望只发送差异部分
	// 原理：三路合并（Original + Current + Modified）
	// =============================================
	if cm.Annotations["patching-demo/strategy"] == "mergefrom" {
		logger.Info("🔧 Executing MergeFrom patch...")

		// 1. 保存原始状态（用于三路合并）
		original := cm.DeepCopy()

		// 2. 修改字段
		if cm.Annotations == nil {
			cm.Annotations = make(map[string]string)
		}
		cm.Annotations["patched-by"] = "mergefrom-strategy"
		cm.Data["merged-key"] = "merged-value"

		// 3. 发送 Patch 请求（只发送差异部分）
		if err := r.Patch(ctx, &cm, client.MergeFrom(original)); err != nil {
			logger.Error(err, "Failed to patch with MergeFrom")
			return ctrl.Result{}, err
		}

		logger.Info("✅ MergeFrom patch succeeded!")
		return ctrl.Result{}, nil
	}

	//// =============================================
	//// 🎯 策略 2: StrategicMergeFrom（K8s 原生合并）
	//// =============================================
	//// 适用场景：需要智能合并列表字段（如 Pod Containers）
	//// 原理：K8s 定义了 patchStrategy 标记来指导合并行为
	//// =============================================
	//if cm.Annotations["patching-demo/strategy"] == "strategic" {
	//	logger.Info("🔧 Executing StrategicMergeFrom patch...")
	//
	//	original := cm.DeepCopy()
	//
	//	if cm.Annotations == nil {
	//		cm.Annotations = make(map[string]string)
	//	}
	//	cm.Annotations["patched-by"] = "strategic-merge-strategy"
	//	cm.Data["strategic-key"] = "strategic-value"
	//
	//	if err := r.Patch(ctx, &cm, client.StrategicMergeFrom(original)); err != nil {
	//		logger.Error(err, "Failed to patch with StrategicMergeFrom")
	//		return ctrl.Result{}, err
	//	}
	//
	//	logger.Info("✅ StrategicMergeFrom patch succeeded!")
	//	return ctrl.Result{}, nil
	//}
	//
	//// =============================================
	//// 🎯 策略 3: Server-Side Apply（K8s 1.18+ 推荐）
	//// =============================================
	//// 适用场景：多个 Controller/用户协作修改同一资源
	//// 原理：Field Ownership 模型，K8s 记录每个字段的 "Owner"
	//// =============================================
	//if cm.Annotations["patching-demo/strategy"] == "ssa" {
	//	logger.Info("🔧 Executing Server-Side Apply...")
	//
	//	// 1. 构造目标对象（不需要先 Get）
	//	patchObj := &corev1.ConfigMap{
	//		ObjectMeta: metav1.ObjectMeta{
	//			Name:      cm.Name,
	//			Namespace: cm.Namespace,
	//		},
	//	}
	//
	//	// 2. 设置要管理的字段
	//	if patchObj.Annotations == nil {
	//		patchObj.Annotations = make(map[string]string)
	//	}
	//	patchObj.Annotations["patched-by"] = "server-side-apply"
	//	patchObj.Data = map[string]string{
	//		"ssa-key": "ssa-value",
	//	}
	//
	//	// 3. 执行 Apply（需要 ForceOwnership 处理冲突）
	//	if err := r.Patch(ctx, patchObj, client.Apply, client.FieldOwner("patching-demo")); err != nil {
	//		logger.Error(err, "Failed to apply with SSA")
	//		return ctrl.Result{}, err
	//	}
	//
	//	logger.Info("✅ Server-Side Apply succeeded!")
	//	return ctrl.Result{}, nil
	//}
	//
	//// =============================================
	//// 🎯 策略 4: JSONPatch（精确操作）
	//// =============================================
	//// 适用场景：需要原子性操作（add/remove/replace）
	//// 原理：RFC 6902 JSON Patch，按顺序执行操作
	//// =============================================
	//if cm.Annotations["patching-demo/strategy"] == "json" {
	//	logger.Info("🔧 Executing JSONPatch...")
	//
	//	// JSONPatch 需要手动构造 patch 数据
	//	// 使用 client.RawPatch 发送原始 JSON Patch 操作
	//	patchData := []byte(`[
	//		{"op": "add", "path": "/data/jsonpatch-key", "value": "jsonpatch-value"},
	//		{"op": "add", "path": "/metadata/annotations/patched-by", "value": "jsonpatch-strategy"}
	//	]`)
	//
	//	if err := r.Patch(ctx, &cm, client.RawPatch(types.JSONPatchType, patchData)); err != nil {
	//		logger.Error(err, "Failed to patch with JSONPatch")
	//		return ctrl.Result{}, err
	//	}
	//
	//	logger.Info("✅ JSONPatch succeeded!")
	//	return ctrl.Result{}, nil
	//}
	//
	//// =============================================
	//// 🎯 策略 5: Status Subresource Patch（状态更新）
	//// =============================================
	//// 适用场景：只更新资源的状态字段，不触碰 Spec
	//// 注意：需要 CRD 启用 subresources.status 才能使用
	//// =============================================
	//if cm.Annotations["patching-demo/strategy"] == "status" {
	//	logger.Info("🔧 Executing Status Patch...")
	//
	//	// 注意：ConfigMap 没有 /status 子资源，这个分支仅用于演示 API 用法
	//	// 对于 CRD，应该使用：r.Status().Patch(ctx, &cr, client.MergeFrom(original))
	//	// 这里我们用普通 Update 模拟
	//	if cm.Annotations == nil {
	//		cm.Annotations = make(map[string]string)
	//	}
	//	cm.Annotations["status-patched"] = "true"
	//
	//	// 对于 ConfigMap，我们只能用 Update 模拟
	//	// 对于 CRD，正确的做法是：
	//	//   r.Status().Patch(ctx, &cr, client.MergeFrom(original))
	//	if err := r.Update(ctx, &cm); err != nil {
	//		logger.Error(err, "Failed to update status")
	//		return ctrl.Result{}, err
	//	}
	//
	//	logger.Info("✅ Status patch succeeded! (using Update for ConfigMap demo)")
	//	return ctrl.Result{}, nil
	//}

	// 如果还没有设置策略标记，初始化它
	if cm.Annotations == nil {
		cm.Annotations = make(map[string]string)
	}
	if cm.Annotations["patching-demo/strategy"] == "" {
		original := cm.DeepCopy()
		cm.Annotations["patching-demo/strategy"] = "mergefrom"
		cm.Annotations["patching-demo/instructions"] = "modify this annotation to: mergefrom, strategic, ssa, json, or status"

		if err := r.Patch(ctx, &cm, client.MergeFrom(original)); err != nil {
			logger.Error(err, "Failed to initialize annotations")
			return ctrl.Result{}, err
		}

		logger.Info("🎓 Patching Demo Initialized! Modify the annotation to try different strategies.")
	}

	return ctrl.Result{}, nil
}

func main() {
	opts := zap.Options{Development: true}
	opts.BindFlags(flag.CommandLine)
	flag.Parse()
	log.SetLogger(zap.New(zap.UseFlagOptions(&opts)))

	setupLog := ctrl.Log.WithName("setup")

	scheme := runtime.NewScheme()
	_ = corev1.AddToScheme(scheme)

	mgr, err := ctrl.NewManager(ctrl.GetConfigOrDie(), ctrl.Options{
		Scheme: scheme,
	})
	if err != nil {
		setupLog.Error(err, "unable to start manager")
		os.Exit(1)
	}

	if err = ctrl.NewControllerManagedBy(mgr).
		For(&corev1.ConfigMap{}).
		Complete(&PatchingReconciler{Client: mgr.GetClient(), Scheme: scheme}); err != nil {
		setupLog.Error(err, "unable to create controller")
		os.Exit(1)
	}

	setupLog.Info("🚀 Starting Patching Demo Controller.")
	if err := mgr.Start(ctrl.SetupSignalHandler()); err != nil {
		setupLog.Error(err, "problem running manager")
		os.Exit(1)
	}
}
